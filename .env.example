# Firebase — configuración pública del proyecto (Project Settings > General > Your apps > SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Cloud Messaging — clave pública VAPID (Project Settings > Cloud Messaging > Web configuration)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK — JSON completo de la cuenta de servicio, en una sola línea
# (Project Settings > Service Accounts > Generate new private key). NUNCA exponer con prefijo NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Meta Pixel (ya existente en el proyecto)
NEXT_PUBLIC_META_PIXEL_ID=

# IndexNow — protegen los endpoints de notificación contra abuso
# INDEXNOW_SECRET: header "x-indexnow-secret" para POST /api/indexnow
# CRON_SECRET: header "Authorization: Bearer" para GET /api/indexnow/cron
# WP_WEBHOOK_SECRET: campo "secret" del payload para POST /api/indexnow/webhook
INDEXNOW_SECRET=
CRON_SECRET=
WP_WEBHOOK_SECRET=

# Clave IndexNow (ya en public/7f3e2b1c4d8f9a0b3c6d1e4f7a2b5c8e.txt, no moverla)
INDEXNOW_KEY=7f3e2b1c4d8f9a0b3c6d1e4f7a2b5c8e
